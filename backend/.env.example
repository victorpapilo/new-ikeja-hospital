# Rename this file to .env before running the server

# MongoDB Atlas connection string (get this from your Atlas cluster -> "Connect" -> "Drivers")
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/newikejahospital?retryWrites=true&w=majority

# Port the API server runs on
PORT=5000

# Secret used to sign the admin login token - make this a long random string
JWT_SECRET=change_this_to_a_long_random_string

# Simple admin login (used only for the /api/admin routes that list appointments/messages)
ADMIN_EMAIL=admin@newikejahospital.com
ADMIN_PASSWORD=change_this_password

# The URL of your deployed frontend (used for CORS). For local dev this is fine as-is.
CLIENT_URL=http://localhost:5173
